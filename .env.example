# Sao chep thanh file ".env" (cung thu muc voi docker-compose.yml) roi dien khoa that.
# Tao khoa mien phi tai https://console.groq.com/keys . Khong dua file .env len Git/Drive cong khai.
GROQ_API_KEY=
# Mo hinh tren Groq (llama-3.3-70b-versatile da ngung tu 16/08/2026)
GROQ_MODEL=openai/gpt-oss-120b
